{
  "name": "@seij/common-ui-richtext",
  "version": "0.4.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/seij-net/seij-commons-js.git"
  },
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "vite build -c vite.config.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "watch": "tsc -p tsconfig.lib.json --noEmit --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fluentui/react-components": "workspace:^",
    "@fluentui/react-icons": "workspace:^",
    "@lexical/code-core": "workspace:^",
    "@lexical/code-shiki": "workspace:^",
    "@lexical/extension": "workspace:^",
    "@lexical/link": "workspace:^",
    "@lexical/list": "workspace:^",
    "@lexical/history": "workspace:^",
    "@lexical/markdown": "workspace:^",
    "@lexical/react": "workspace:^",
    "@lexical/rich-text": "workspace:^",
    "@lexical/selection": "workspace:^",
    "@seij/common-ui": "workspace:^",
    "lexical": "workspace:^"
  },
  "peerDependencies": {
    "react": "workspace:^",
    "react-dom": "workspace:^"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ]
}
